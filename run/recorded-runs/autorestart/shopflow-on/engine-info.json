ingGapShare":[0.3,1],"explainAwayGamma":[0,2],"cascadeEdgeProbability":[0.05,1]},"docs":{"minHistorySamples":"How many past samples a service needs before it is judged at all. Below this it is skipped rather than guessed at, so a service that just started does not alert on its first reading.","zScoreAnomaly":"How far from its own recent baseline a metric must move to count as anomalous, in noise-normalised standard deviations (a healthy series' normal extreme is about 3). Lower fires more often.","zScoreHigh":"Deviation at or above this is HIGH rather than MEDIUM.","zScoreCritical":"Deviation at or above this is CRITICAL.","minDeltaPercent":"Even a large z-score is ignored unless the metric moved this many percentage points from its baseline. Stops an idle service going from 0.05% to 2% CPU from raising an incident.","absoluteHighPercent":"A CPU or memory reading above this is HIGH no matter how calm the baseline is - a service pinned at 75% is worth seeing even if it has been there long enough to look normal.","absoluteCriticalPercent":"A reading above this is CRITICAL regardless of deviation.","flatlineStdDev":"Below this standard deviation the baseline counts as flat. Dividing by a near-zero deviation makes z-scores explode, so the flat case is judged on absolute movement instead.","flatlineDeltaPercent":"On a flat baseline, how many points a metric must jump to be anomalous. This is the rule that catches an idle service suddenly doing work.","flatlineCriticalPercent":"On a flat baseline, a value above this is CRITICAL rather than HIGH.","criticalServicesForCritical":"How many services must be critical at once before the whole incident is CRITICAL rather than HIGH.","silenceSamples":"A service that is normally busy (CPU or network) and shows no activity at all for this many samples in a row is treated as frozen. This is how a hung service is caught: it sends no errors, it just goes quiet.","monitoringGapShare":"If at least this share of a target's services go silent or vanish at the same moment, the mapper reports a monitoring outage (collector or SSH problem) instead of blaming services.","explainAwayGamma":"How strongly a broken dependency explains its callers' errors and slowness. 1 = fully; 0 = ignore the call graph and rank by how abnormal each service is.","cascadeEdgeProbability":"Assumed chance that a failure spreads across one call edge, used for the \"at risk next\" list. It ranks who to watch; it is not a calibrated probability."}},"ml":{"baseline":{"window":120,"minTrain":30,"retrainEvery":10,"quantile":0.97,"driftAfter":360,"mildLevel":3,"mildDriftAfter":24,"trees":100,"sampleSize":64,"minRequests":5,"jitter":0.5,"seed":0,"lineK":3,"rangeK":5,"floors":[0.15,0.05,0.15,0.15,0.15,0.02,0.15,3],"detector":"iforest","ensemble":["iforest","knn","mahalanobis","hbos"],"oneSided":true,"forecastWindow":24,"forecastHorizon":24,"forecastR2":0.6},"walk":{"alpha":0.15,"rho":0.2,"iterations":60},"anomalyFloor":0.5,"servicePersist":2,"hardFirst":true,"useWalk":true,"useOwn":true,"loopWindow":36,"loopHold":12,"rca":"walk","alarmLevel":2,"warnAt":2,"stoppedIsDown":true},"hybrid":{"detection":"or-strict","ranking":"ml","rulesAlone":1.25,"mlWeight":0.5}},"offline":{"note":"Offline evaluation on recorded runs with injected faults. detected = share of faults with an alarm naming a touched service; caughtAndNamed = detected and the true root ranked first; falseAlarmsPerHour = alarms with no fault active.","sets":{"real":{"label":"Recorded runs (ShopFlow + LedgerLine)","faults":62,"hours":3.614,"engines":{"rules":{"detected":0.903,"top1OfDetected":0.714,"caughtAndNamed":0.645,"falseAlarmsPerHour":9.226,"alarmShare":0.086},"ml":{"detected":0.871,"top1OfDetected":0.833,"caughtAndNamed":0.726,"falseAlarmsPerHour":2.306,"alarmShare":0.051},"hybrid":{"detected":0.903,"top1OfDetected":0.821,"caughtAndNamed":0.742,"falseAlarmsPerHour":6.151,"alarmShare":0.067}}},"test":{"label":"Held-out synthetic stress set","faults":178,"hours":15.978,"engi