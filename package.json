{
  "name": "microservice-mapper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run start",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install && cd ../remote-collector && npm install && cd ../traffic-gen && npm install",
    "traffic-gen": "cd traffic-gen && npm start",
    "export-telemetry": "node server/node_modules/tsx/dist/cli.mjs scripts/export_vectorized_telemetry.ts",
    "test": "node server/node_modules/tsx/dist/cli.mjs --test \"tests/*.test.ts\"",
    "setup": "npm run install:all && npm run doctor",
    "doctor": "node scripts/doctor.mjs",
    "start": "npm run dev",
    "eval": "node server/node_modules/tsx/dist/cli.mjs tools/eval/run.ts",
    "local": "node scripts/local.mjs",
    "demo": "node scripts/demo.mjs",
    "hosts": "node scripts/hosts.mjs",
    "ml": "node server/node_modules/tsx/dist/cli.mjs tools/ml/run.ts",
    "ml:report": "node server/node_modules/tsx/dist/cli.mjs tools/ml/report.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
